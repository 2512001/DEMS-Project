# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=6d

# Evidence Encryption
EVIDENCE_AES_KEY=your-32-byte-hex-key-here

# IPFS Configuration
GATEWAY_URL=your-pinata-gateway-url
PINATA_JWT=your-pinata-jwt-token

# Blockchain Configuration
EVIDENCE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
RPC_URL=http://127.0.0.1:8545

# Email Configuration (SMTP)
# Leave empty for development mode (emails will be logged to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@dems.com

# Frontend URL for invitation links
FRONTEND_URL=http://127.0.0.1:5173