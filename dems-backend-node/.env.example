# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=6d

# Evidence Encryption (Phase 2: Multi-Party Key Management)
# Legacy single key (for backward compatibility with old evidence)
EVIDENCE_AES_KEY=your-32-byte-hex-key-here

# Key Derivation Secrets (Phase 2: Required for new uploads)
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
USER_KEY_SECRET=<random-32-byte-hex>
ORG_ADMIN_KEY_SECRET=<random-32-byte-hex>
SUPER_ADMIN_KEY_SECRET=<random-32-byte-hex>

# IPFS Configuration
GATEWAY_URL=your-pinata-gateway-url
PINATA_JWT=your-pinata-jwt-token

# Blockchain Configuration
EVIDENCE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
RPC_URL=http://127.0.0.1:8545

# Email Configuration (SMTP) - REQUIRED FOR REAL EMAIL DELIVERY
# Gmail will reject your normal account password.
# 1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character App Password as SMTP_PASSWORD (spaces are ignored)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM=DEMS <your-email@gmail.com>

# Frontend URL for invitation links
FRONTEND_URL=http://127.0.0.1:5173